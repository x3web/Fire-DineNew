{
  "name": "fire-and-dine/catalogue",
  "description": "Fire & Dine catalogue, configuration and quote application",
  "type": "project",
  "require": {"php": ">=8.1", "ext-pdo": "*", "ext-json": "*", "ext-filter": "*", "ext-session": "*", "ext-fileinfo": "*", "ext-openssl": "*"},
  "require-dev": {"phpunit/phpunit": "10.5.55"},
  "autoload": {"psr-4": {"FireDine\\": "src/"}},
  "autoload-dev": {"psr-4": {"FireDineTests\\": "tests/phpunit/"}},
  "scripts": {
    "test": ["@test-php", "@test-browser"],
    "test-php": "phpunit --configuration phpunit.xml",
    "test-browser": "npm test"
  }
}
